# AIQE Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ==================================================
# AIQE CORE SETTINGS
# ==================================================

AIQE_ENV=development
# Options: development | production | testing

AIQE_LOG_LEVEL=INFO
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL

AIQE_WORKSPACE_DIR=.aiqe
# Directory where AIQE stores workflow contexts, checkpoints, and artifacts

# ==================================================
# AI PROVIDER API KEYS
# At least one provider must be configured.
# AIQE supports multiple keys per provider for rotation.
# ==================================================

# OpenAI
OPENAI_API_KEY_1=
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=

# Anthropic
ANTHROPIC_API_KEY_1=
ANTHROPIC_API_KEY_2=

# Google Gemini
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

# Groq
GROQ_API_KEY_1=

# OpenRouter
OPENROUTER_API_KEY_1=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=

# Ollama (local models - no key required)
OLLAMA_BASE_URL=http://localhost:11434

# ==================================================
# DEFAULT AI PROVIDER SETTINGS
# ==================================================

AIQE_DEFAULT_PROVIDER=openai
# Options: openai | anthropic | gemini | groq | openrouter | azure | ollama

AIQE_DEFAULT_MODEL=gpt-4o
AIQE_MAX_TOKENS=4096
AIQE_TEMPERATURE=0.1

# ==================================================
# DATABASE SETTINGS
# ==================================================

AIQE_DATABASE_MODE=sqlite
# Options: sqlite | postgres

# SQLite (local/CLI mode)
AIQE_SQLITE_PATH=.aiqe/aiqe.db

# PostgreSQL (enterprise mode)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aiqe
POSTGRES_USER=
POSTGRES_PASSWORD=

# ==================================================
# GITHUB INTEGRATION
# ==================================================

GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# ==================================================
# NOTIFICATIONS
# ==================================================

# Slack
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Microsoft Teams
TEAMS_WEBHOOK_URL=

# ==================================================
# ENTERPRISE SETTINGS
# ==================================================

AIQE_ENTERPRISE_MODE=false
AIQE_MAX_CONCURRENT_WORKFLOWS=5
AIQE_CHECKPOINT_ENABLED=true
AIQE_AUDIT_LOG_ENABLED=true

# ==================================================
# SECURITY SETTINGS
# ==================================================

AIQE_ENCRYPTION_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

AIQE_PLUGIN_SANDBOX_ENABLED=true
AIQE_PLUGIN_CAPABILITY_DISPLAY=true
# Show plugin permissions to user before loading (recommended: true)
